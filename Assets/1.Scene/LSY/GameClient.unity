  prevButton: {fileID: 0}
  nextButton: {fileID: 0}
  pages:
  - smallTitle: "\uAC8C\uC784 \uC900\uBE44"
    mainText: "\uAC8C\uC784\uC744 \uC2DC\uC791\uD558\uBA74 \uD328\uB97C \uC815\uB9AC\uD558\uB294
      \uC2DC\uAC04\uC744 60\uCD08 \uB3D9\uC548 \uAC00\uC838\uC694.\n\uC774\uB54C
      \uB9C8\uC6B0\uC2A4\uB85C \uD328 \uC704\uCE58\uB97C \uC870\uC815\uD560 \uC218
      \uC788\uACE0, \uC900\uBE44\uAC00 \uB05D\uB098\uBA74 \u201C\uC900\uBE44\uC644\uB8CC\u201D
      \uBC84\uD2BC\uC744 \uB20C\uB7EC\uC8FC\uC138\uC694."
    pageImg: {fileID: 21300000, guid: 68637a0b006a38240b68cc83c88210de, type: 3}
    customUI: {fileID: 0}
    slides: []
  - smallTitle: 
    mainText: 
    pageImg: {fileID: 0}
    customUI: {fileID: 0}
    slides: []
  - smallTitle: "\uAC8C\uC784 \uC2DC\uC791"
    mainText: "\uAC8C\uC784 \uC2DC\uC791\uC740 \uAC00\uC7A5 \uB0AE\uC740 \uD328\uC778\n'\uAD6C\uB984
      3'\uC744 \uAC00\uC9C4 \uC0AC\uB78C\uC774 \uCCAB \uC21C\uC11C\uAC00 \uB3FC\uC694."
    pageImg: {fileID: 21300000, guid: f950363e2f3c3064681dd66ce23fbd70, type: 3}
    customUI: {fileID: 0}
    slides: []
  - smallTitle: "\uD328\uB97C \uB0B4\uB294 \uBC29\uBC95"
    mainText: 
    pageImg: {fileID: 0}
    customUI: {fileID: 0}
    slides:
    - {fileID: 0}
    - {fileID: 0}
  - smallTitle: "\uC871\uBCF4\uD45C"
    mainText: "\uC778\uAC8C\uC784 \uC624\uB978\uCABD \uD30C\uB780 \uBC84\uD2BC\uC744
      \uBC18\uBCF5 \uD074\uB9AD\uD574\uC11C \uC871\uBCF4\uD45C\uB97C \uC5F4\uACE0
      \uB2EB\uC744 \uC218 \uC788\uC5B4\uC694."
    pageImg: {fileID: 21300000, guid: 917d4a302634a69429d707848a4db24b, type: 3}
    customUI: {fileID: 0}
    slides: []
  - smallTitle: "\uB77C\uC6B4\uB4DC \uC885\uB8CC \uC870\uAC74"
    mainText: "\uB204\uAD70\uAC00 \uC190\uC5D0 \uB4E0 \uBAA8\uB4E0 \uD328\uB97C \uB2E4
      \uB0B4\uBA74 \uB77C\uC6B4\uB4DC\uAC00 \uC885\uB8CC\uB429\uB2C8\uB2E4."
    pageImg: {fileID: 21300000, guid: 58472fd77c979284a9a80dc088637e0d, type: 3}
    customUI: {fileID: 0}
    slides: []
  - smallTitle: "\uC810\uC218(\uCE69) \uACC4\uC0B0"
    mainText: "\uC190\uC5D0 \uD328\uAC00 0\uAC1C\uC778 \uC0AC\uB78C\uC774 \uBB34\uC870\uAC74\uC801\uC73C\uB85C
      1\uB4F1\uC744 \uD569\uB2C8\uB2E4.\r\n\uC790\uC2E0\uBCF4\uB2E4 \uB4F1\uC218\uAC00
      \uB192\uC740 \uC0AC\uB78C\uC5D0\uAC8C \uB0A8\uC740 \uD0C0\uC77C \uAC1C\uC218\uC758
      \uCC28\uC774\uB9CC\uD07C \uCE69\uC744 \uC9C0\uBD88\uD574\uC694."
    pageImg: {fileID: 21300000, guid: 27b81cf7caf3d2849ba679f9c1d4ff9a, type: 3}
    customUI: {fileID: 0}
    slides: []
  - smallTitle: "\uAC8C\uC784 \uC885\uB8CC"
    mainText: "5\uB77C\uC6B4\uB4DC \uC9C4\uD589 \uC774\uD6C4 \uAC8C\uC784\uC774 \uC885\uB8CC\uB429\uB2C8\uB2E4.\r\n\uC815\uC0B0
      \uB54C \uCE69\uC744 \uAC00\uC7A5 \uB9CE\uC774 \uBCF4\uC720\uD55C \uD50C\uB808\uC774\uC5B4\uC758
      \uC21C\uC11C\uB300\uB85C \uC21C\uC704\uAC00 \uC815\uD574\uC9D1\uB2C8\uB2E4."
    pageImg: {fileID: 21300000, guid: 5dc37671a0f32c74c854af4f5e2d3444, type: 3}
    customUI: {fileID: 0}
    slides: []
